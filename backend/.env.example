# Optional. If unset, the app runs fully in MOCK_MODE using deterministic,
# knowledge-base-grounded text generation instead of calling an LLM.
ANTHROPIC_API_KEY=

# Model used for the three narrative-reasoning call sites (recommendation
# rationale, executive summary, free-text problem parsing). Not used for
# scoring, ROI, or any financial/ranking calculation.
ANTHROPIC_MODEL=claude-sonnet-4-5

# SQLite file path (created automatically on first run).
DATABASE_URL=sqlite:///./transformiq.db

# Comma-separated origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
